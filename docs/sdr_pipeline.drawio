Color=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="885" width="60" height="40" as="geometry"/></mxCell><mxCell id="v109" value="&lt;b&gt;×2&lt;/b&gt; stacked: one instance per channel" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="110" y="890" width="220" height="40" as="geometry"/></mxCell><mxCell id="v110" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="340" y="885" width="60" height="40" as="geometry"/></mxCell><mxCell id="v111" value="single: shared by both channels" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="890" width="220" height="40" as="geometry"/></mxCell><mxCell id="e112" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="905" as="sourcePoint"/><mxPoint x="720" y="905" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v113" value="bold arrow: carries both channels" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="730" y="895" width="300" height="40" as="geometry"/></mxCell><mxCell id="v114" value="&lt;b&gt;Stage order for implementation (working backwards from UART):&lt;/b&gt; 1 host link layer → 2 source combiner → 3 frame sync + CRC → 4 symbol timing → 5 discriminator → 6 decimate/FIR → 7 NCO/mixer → 8 sample conditioning → 9 XADC.&lt;br&gt;Spectrum/constellation taps can land once the DDC exists. Upstream stages are verified in simulation with synthetic vectors (reference model: APEX sim/scripts/radio_gfsk_rx.py) before XADC hardware." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="950" width="1000" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
