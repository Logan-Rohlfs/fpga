<mxfile host="drawio"><diagram id="sdr-pipeline" name="SDR pipeline"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="3900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="&lt;b style=&quot;font-size:24px&quot;&gt;FPGA SDR receiver: end-to-end module map&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=24;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="3000" height="40" as="geometry"/></mxCell><mxCell id="v2" value="Two antennas feed two identical receive chains (stacked &lt;b&gt;×2&lt;/b&gt; blocks, one per channel), which merge in the best-source combiner into one host link. &lt;b&gt;Bold arrows&lt;/b&gt; carry both channels. Single 100 MHz clock domain on the Basys 3 (xc7a35t). TBD = design choice not yet made; RF values from APEX fsw/src/radio.cpp." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="3200" height="40" as="geometry"/></mxCell><mxCell id="v3" value="RF frontend (analog, off-FPGA)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4f8fd;strokeColor=#6c8ebf;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="110" width="1020" height="560" as="geometry"/></mxCell><mxCell id="v4" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="48" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v5" value="&lt;b&gt;Yagi antenna  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;A: 5-element, B: 15-element&lt;br&gt;different orientation/pointing&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="248" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v7" value="&lt;b&gt;Bandpass filter  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Butterworth&lt;br&gt;428–438 MHz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="240" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="v8" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="448" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v9" value="&lt;b&gt;DC block + LNA  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Nooelec LaNA&lt;br&gt;USB / bias-tee power&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="440" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="v10" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="648" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v11" value="&lt;b&gt;RF mixer  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ZX05-1-S+&lt;br&gt;RF − LO → ~100 kHz IF&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="v12" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="848" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v13" value="&lt;b&gt;IF conditioning  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;LPF / anti-alias &amp;lt;500 kHz&lt;br&gt;gain, bias to 0–1 V&lt;br&gt;overvoltage protection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="840" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v5" target="v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v7" target="v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v9" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v11" target="v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v18" value="&lt;b&gt;LO: PLL synthesizer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;shared by both mixers&lt;br&gt;~441.38 MHz (TBD)&lt;br&gt;FPGA-tunable later&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="640" y="480" width="170" height="80" as="geometry"/></mxCell><mxCell id="e19" value="LO → A, B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v18" target="v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v20" value="Carrier ≈441.48 MHz (user-reported); 2-GFSK, ±25 kHz deviation, 10 kbps now → 43 kbps goal. Bench TX+RX crystal offset ≈ +10 kHz, so the IF lands near 100 ± 35 kHz. XADC auxiliary inputs accept 0–1 V (unipolar) on the JXADC VAUXP/N pairs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="980" height="70" as="geometry"/></mxCell><mxCell id="v21" value="FPGA (Basys 3, Artix-7)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffdf3;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1070" y="110" width="2240" height="1000" as="geometry"/></mxCell><mxCell id="v22" value="&lt;b&gt;XADC  (single)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;7-series XADC primitive&lt;br&gt;simultaneous sampling:&lt;br&gt;ADC A + ADC B, 12-bit,&lt;br&gt;≤1 MS/s each&lt;br&gt;DRP + EOC/EOS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1090" y="280" width="160" height="150" as="geometry"/></mxCell><mxCell id="e23" value="JXADC pairs A, B&lt;br&gt;0–1 V analog" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v13" target="v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v24" value="&lt;b&gt;Sample conditioning  (single)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;xadc_sampler&lt;br&gt;wait data-ready, read channel tag&lt;br&gt;extract 12-bit code&lt;br&gt;subtract midpoint → signed&lt;br&gt;demux → valid_A / valid_B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1290" y="280" width="160" height="150" as="geometry"/></mxCell><mxCell id="e25" value="DRP reads&lt;br&gt;(tagged)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v22" target="v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v26" value="Per-channel receive chain  ×2  (instantiated for A and B)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e0;strokeColor=#d6b656;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1470" y="140" width="1010" height="340" as="geometry"/></mxCell><mxCell id="v27" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1498" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v28" value="&lt;b&gt;NCO + I/Q mixer  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;digital downconversion&lt;br&gt;sin/cos LUT, tunable FTW&lt;br&gt;IF → ~0 Hz&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1490" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="v29" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1698" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v30" value="&lt;b&gt;Decimate + channel FIR  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;accumulate/CIC ÷N (e.g. 10)&lt;br&gt;+ low-pass FIR (±35 kHz)&lt;br&gt;rejects 2×IF products&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1690" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="v31" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1898" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v32" value="&lt;b&gt;GFSK discriminator  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Δphase of I/Q:&lt;br&gt;I[n-1]Q[n] − Q[n-1]I[n]&lt;br&gt;→ instantaneous freq&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1890" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="v33" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2098" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v34" value="&lt;b&gt;Symbol timing + slicer  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;timing recovery (TBD:&lt;br&gt;zero-crossing / Gardner)&lt;br&gt;sample at symbol center,&lt;br&gt;sign → bit&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2090" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="v35" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2298" y="292" width="170" height="110" as="geometry"/></mxCell><mxCell id="v36" value="&lt;b&gt;Frame sync + CRC  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;correlate 0xAA×4 + 2DD4&lt;br&gt;type → length, MSB-first bytes&lt;br&gt;CRC-16-CCITT (init FFFF)&lt;br&gt;+ per-frame metadata&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2290" y="300" width="170" height="110" as="geometry"/></mxCell><mxCell id="e37" value="s12 per channel&lt;br&gt;@ fs (TBD)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v24" target="v28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e38" value="I/Q @ fs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v28" target="v30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e39" value="I/Q @ fs/N" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v30" target="v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e40" value="freq est" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v32" target="v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e41" value="bits + valid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v34" target="v36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v42" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1698" y="177" width="170" height="75" as="geometry"/></mxCell><mxCell id="v43" value="&lt;b&gt;Power / RSSI  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;|I|²+|Q|², averaged&lt;br&gt;noise floor, SNR est&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1690" y="185" width="170" height="75" as="geometry"/></mxCell><mxCell id="v44" value="" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2098" y="177" width="170" height="75" as="geometry"/></mxCell><mxCell id="v45" value="&lt;b&gt;Freq offset + quality  ×2&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;mean Δf over preamble&lt;br&gt;sync correlation score&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2090" y="185" width="170" height="75" as="geometry"/></mxCell><mxCell id="e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v30" target="v43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v32" target="v45"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1975" y="275"/><mxPoint x="2175" y="275"/></Array></mxGeometry></mxCell><mxCell id="e48" value="RSSI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v43" target="v36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1775" y="165"/><mxPoint x="2332" y="165"/></Array></mxGeometry></mxCell><mxCell id="e49" value="Δf, q" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.65;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v45" target="v36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v50" value="&lt;i&gt;Everything in this region exists once per channel; B is identical to A. Per-frame metadata = bytes, CRC ok, RSSI, sync quality, Δf, timestamp.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1490" y="430" width="980" height="40" as="geometry"/></mxCell><mxCell id="v51" value="&lt;b&gt;Spectrum engine (waterfall)  (single)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;window + FFT (N TBD, e.g. 256)&lt;br&gt;|X|² in dB, averaged&lt;br&gt;time-shared between A/B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1590" y="540" width="220" height="100" as="geometry"/></mxCell><mxCell id="v52" value="&lt;b&gt;Constellation capture  (single)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;snapshot K I/Q pairs&lt;br&gt;(post-filter) on trigger /&lt;br&gt;periodic, alternating A/B&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1890" y="540" width="220" height="100" as="geometry"/></mxCell><mxCell id="e53" value="I/Q A, B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v28" target="v51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e54" value="I/Q A, B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v30" target="v52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v55" value="&lt;b&gt;Source combiner  (single)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;align frames by type + seq&lt;br&gt;dedupe A/B copies&lt;br&gt;&lt;b&gt;best-source select&lt;/b&gt;:&lt;br&gt;CRC ok, then quality/RSSI&lt;br&gt;&lt;br&gt;&lt;i&gt;stretch:&lt;/i&gt; if both fail CRC,&lt;br&gt;bit-/soft-combine and retry&lt;br&gt;&lt;br&gt;→ one best stream&lt;br&gt;+ per-channel frame records&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2510" y="240" width="180" height="230" as="geometry"/></mxCell><mxCell id="e56" value="frames A, B&lt;br&gt;+ metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=3;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v36" target="v55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v57" value="&lt;b&gt;Link statistics  (single)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;per-channel counters: good/bad CRC,&lt;br&gt;sync hits, selected-from, seq gaps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2510" y="760" width="180" height="90" as="geometry"/></mxCell><mxCell id="e58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v55" target="v57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v59" value="&lt;b&gt;Timebase + status  (single)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;free-running timestamp&lt;br&gt;heartbeat, build ID, overflow flags&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="2510" y="890" width="180" height="80" as="geometry"/></mxCell><mxCell id="v60" value="Host link layer  (NEXT MODULE, single)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff7ee;strokeColor=#d79b00;strokeWidth=3;verticalAlign=top;align=center;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2730" y="170" width="560" height="820" as="geometry"/></mxCell><mxCell id="v61" value="&lt;b&gt;Message framer + arbiter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;typed messages from each producer:&lt;br&gt;&lt;br&gt;• BEST_TELEM&lt;br&gt;• CHAN_FRAME (A/B + meta)&lt;br&gt;• METRICS / LINK_STATS&lt;br&gt;• SPECTRUM rows&lt;br&gt;• IQ snapshot&lt;br&gt;• STATUS heartbeat&lt;br&gt;&lt;br&gt;fixed-priority arbitration&lt;br&gt;(telemetry &amp;gt; metrics &amp;gt; viz)&lt;br&gt;whole messages only&lt;br&gt;&lt;br&gt;message: type, seq, len,&lt;br&gt;payload, CRC-16&lt;br&gt;&lt;b&gt;COBS-encoded, 0x00 delimiter&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="2750" y="220" width="200" height="620" as="geometry"/></mxCell><mxCell id="v62" value="&lt;b&gt;COBS encoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;one-message buffer&lt;br&gt;backpatched codes&lt;br&gt;+ 0x00 delimiter&lt;br&gt;(1024 B)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="2980" y="450" width="120" height="160" as="geometry"/></mxCell><mxCell id="v63" value="&lt;b&gt;uart_tx.sv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;8N1, valid/ready&lt;br&gt;&lt;b&gt;115200 → 1 Mbaud&lt;/b&gt;&lt;br&gt;(100 clk/bit)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="3130" y="470" width="140" height="120" as="geometry"/></mxCell><mxCell id="e64" value="bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v61" target="v62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e65" value="bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v62" target="v63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e66" value="best stream&lt;br&gt;+ chan frames" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="v55" target="v61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e67" value="counters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.93;entryDx=0;entryDy=0;" edge="1" parent="1" source="v57" target="v61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e68" value="status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.99;entryDx=0;entryDy=0;" edge="1" parent="1" source="v59" target="v61"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2720" y="930"/><mxPoint x="2720" y="834"/></Array></mxGeometry></mxCell><mxCell id="e69" value="spectrum rows" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="v51" target="v61"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1850" y="610"/><mxPoint x="1850" y="700"/><mxPoint x="2715" y="700"/><mxPoint x="2715" y="685"/></Array></mxGeometry></mxCell><mxCell id="e70" value="I/Q snapshot" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.83;entryDx=0;entryDy=0;" edge="1" parent="1" source="v52" target="v61"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2150" y="590"/><mxPoint x="2150" y="735"/><mxPoint x="2740" y="735"/></Array></mxGeometry></mxCell><mxCell id="v71" value="&lt;b&gt;Why next:&lt;/b&gt; every upstream block reports through it, so each new stage can be exercised on hardware as soon as it exists.&lt;br&gt;Budget ≈20–40 kB/s total; 1 Mbaud ≈ 100 kB/s. Existing &lt;i&gt;SDR READY&lt;/i&gt; diagnostic becomes a framed STATUS message." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2750" y="860" width="520" height="120" as="geometry"/></mxCell><mxCell id="v72" value="&lt;b&gt;uart_rx + command decoder&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;host → FPGA commands&lt;br&gt;with acknowledgement&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="2290" y="1010" width="170" height="80" as="geometry"/></mxCell><mxCell id="v73" value="&lt;b&gt;Config registers&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;NCO FTW, stream enables,&lt;br&gt;rates, FFT size, triggers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#999999;dashed=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="2090" y="1010" width="170" height="80" as="geometry"/></mxCell><mxCell id="e74" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="v72" target="v73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e75" value="tune / enable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#999999;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v73" target="v28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1515" y="1050"/></Array></mxGeometry></mxCell><mxCell id="v76" value="&lt;i&gt;Future (not in current scope): host → FPGA control path, UART RX pin B18.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1540" y="1060" width="540" height="30" as="geometry"/></mxCell><mxCell id="v77" value="Host PC (Mac)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#faf6fc;strokeColor=#9673a6;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3340" y="110" width="540" height="1000" as="geometry"/></mxCell><mxCell id="v78" value="&lt;b&gt;FT2232 USB-UART&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Basys 3 bridge&lt;br&gt;(JTAG on other port)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="3360" y="470" width="140" height="120" as="geometry"/></mxCell><mxCell id="e79" value="UART TX (A18)&lt;br&gt;1 Mbaud 8N1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v63" target="v78"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="v80" value="&lt;b&gt;serial_io.py&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Session: connect / read / capture (exists)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="3540" y="230" width="300" height="70" as="geometry"/></mxCell><mxCell id="v81" value="&lt;b&gt;Protocol decoder  (NEXT)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;split on 0x00, COBS-decode, CRC check&lt;br&gt;demux by message type&lt;br&gt;→ typed Python records&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="3540" y="340" width="300" height="90" as="geometry"/></mxCell><mxCell id="v82" value="&lt;b&gt;CLI / TUI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;decoded view,&lt;br&gt;per-type counters&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="3540" y="480" width="140" height="90" as="geometry"/></mxCell><mxCell id="v83" value="&lt;b&gt;GUI (later)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;waterfall, constellation,&lt;br&gt;RSSI, telemetry&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#ffffff;strokeColor=#666666;dashed=1;" vertex="1" parent="1"><mxGeometry x="3700" y="480" width="140" height="90" as="geometry"/></mxCell><mxCell id="v84" value="&lt;b&gt;APEX telemetry parser&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;FLIGHT 0x02 / HK 0x03 / TEST 0x01&lt;br&gt;(port of radio_gfsk_rx.py parse_*)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="3540" y="620" width="300" height="90" as="geometry"/></mxCell><mxCell id="v85" value="&lt;b&gt;Logging&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;raw capture + decoded records, loss from seq gaps&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;verticalAlign=middle;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="3540" y="750" width="300" height="70" as="geometry"/></mxCell><mxCell id=